# Copy to .env for local dev, and add the same keys in Vercel -> Settings -> Environment Variables.
# Only public/publishable values belong here. NEVER put a service role key in this file.

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Public site origin, used for canonical URLs and sitemap.xml
VITE_SITE_URL="https://ak-drapes-elegance.vercel.app"
